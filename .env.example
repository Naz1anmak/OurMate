# ─── Telegram ──────────────────────────────────────────────
BOT_TOKEN=                # @BotFather → /newbot → токен
OWNER_CHAT_ID=            # ваш Telegram user_id (узнать через @userinfobot)
CHAT_ID=                  # ID основной группы (отрицательное число для супергрупп)

# Опциональный SOCKS5-прокси к Telegram Bot API
TELEGRAM_PROXY_URL=       # пример: login:password@host:port или host:port
TELEGRAM_PROXY_ENABLED=false

# ─── LLM ───────────────────────────────────────────────────
API_URL=https://api.deepseek.com/v1/chat/completions
MODEL=deepseek-v4-flash
LLM_API_KEY=              # ключ от провайдера LLM

# ─── Веб-поиск (Tavily) ────────────────────────────────────
# Тул web_search. Пустой ключ = фича выключена (тул не регистрируется).
TAVILY_API_KEY=          # ключ из аккаунта Tavily (tvly-...)
TAVILY_URL=https://api.tavily.com/search
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# ─── Голос (MiniMax TTS) ───────────────────────────────────
# Голосовые ответы клоном голоса. Пустой ключ или voice_id = фича выключена.
# voice_id — id клона из MiniMax (см. README, раздел «Голосовые ответы»).
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=
MINIMAX_TTS_MODEL=speech-2.8-hd      # или speech-2.8-turbo (дешевле)
MINIMAX_API_BASE=https://api.minimax.io
VOICE_MIN_CHARS=35                   # короче — всегда текстом

# ─── Дневные лимиты обращений к LLM ────────────────────────
# Сколько сообщений в сутки один человек может адресовать боту (свой счётчик
# на ЛС и на беседу). Исчерпан — бот отвечает заглушкой, LLM не дёргается.
PM_DAILY_MSG_CAP=30
CHAT_DAILY_MSG_CAP=30
USAGE_DB_PATH=data/usage.db
USAGE_RETENTION_DAYS=30   # старые счётчики подметаются при старте

# ─── Дни рождения ──────────────────────────────────────────
BIRTHDAYS_FILE=data/birthdays.json
LAST_BIRTHDAY_GREETING_FILE=data/cache/last_birthday_greeting.txt
SEND_HOUR=10
SEND_MINUTE=0
# Пауза между probe-запросами при обновлении логинов на старте, секунды.
BIRTHDAY_PROBE_DELAY_SEC=0.1

# ─── Расписание ────────────────────────────────────────────
# Каталог с расписанием. Группы определяются по подпапкам data/<CODE>/, где
# <CODE> — короткий идентификатор группы (он же — суффикс в SCHEDULE_API_GROUP_<CODE>, см. ниже).
# При непустом SCHEDULE_API_GROUP_IDS учитываются только подпапки из whitelist.
SCHEDULE_GROUPS_DIR=data
# Префикс отображаемого имени группы; подклеивается к <CODE> при выводе.
# Пример: SCHEDULE_GROUP_NAME_PREFIX="prefix/" + папка data/A/ → отображение "prefix/A".
# Оставьте пустым, чтобы показывать только <CODE>.
SCHEDULE_GROUP_NAME_PREFIX=
SCHEDULE_CACHE_FILE=data/cache/schedule_cache.json
SCHEDULE_SEND_HOUR=8
SCHEDULE_SEND_MINUTE=0
SCHEDULE_BROADCAST_ENABLED=false

# ─── Автообновление расписания (JSON-API) ──────────────────
# Включает фоновое обновление расписания + lazy-refresh по команде «пары».
SCHEDULE_AUTO_UPDATE_ENABLED=true
# Доп. часы проверки обновлений в течение дня (через запятую, напр. "12,18").
# Пустая строка — доп. проверки отключены (остаются проверки перед утренней
# рассылкой и перед обновлением закрепа).
SCHEDULE_AUTO_REFRESH_HOURS=12,18
# Базовый URL JSON-API расписания — со схемой, без завершающего /.
# Пустое значение = автообновление выключено де-факто.
# Пример: SCHEDULE_API_BASE_URL=https://<домен-портала-расписания>
SCHEDULE_API_BASE_URL=
# ID факультета (нужен только для гиперссылки в сообщениях об ошибке).
SCHEDULE_API_FACULTY_ID=125
# Сколько недель вперёд тянуть (текущая + N).
SCHEDULE_API_WEEKS_AHEAD=3
# Таймаут одного HTTP-запроса к API расписания, секунды.
SCHEDULE_API_HTTP_TIMEOUT=15
# TTL «свежести» snapshot'а для lazy-refresh по команде, минуты.
SCHEDULE_API_LAZY_TTL_MIN=60
# Маппинг подпапок data/<CODE>/ на внутренний group_id из API расписания — по одной переменной на группу.
#
# Внимание: <CODE> и <ID> — это РАЗНЫЕ идентификаторы.
#   <CODE> (слева) — короткое имя группы, оно же имя подпапки data/<CODE>/.
#   <ID>   (справа) — внутренний group_id из системы расписания, число в URL вида
#                     https://<SCHEDULE_API_BASE_URL>/faculty/<SCHEDULE_API_FACULTY_ID>/groups/<ID>?date=YYYY-M-D
#                     Открой свою группу на сайте расписания — это число между `/groups/` и `?date=`.
#
# Пример (две группы с короткими именами A и B):
# SCHEDULE_API_GROUP_A=111111
# SCHEDULE_API_GROUP_B=222222

# Закреплённое сообщение с расписанием в группе
PINNED_SCHEDULE_ENABLED=false
PINNED_SCHEDULE_UPDATE_HOUR=0
PINNED_SCHEDULE_UPDATE_MINUTE=0
# Сколько ближайших учебных дней (дат с парами) показывать в закрепе.
PINNED_SCHEDULE_DAYS_AHEAD=7
PINNED_SCHEDULE_MESSAGE_FILE=data/cache/pinned_schedule_id.txt

# ─── Напоминания ───────────────────────────────────────────
REMINDER_DB_PATH=data/reminders.db
REMINDER_MISFIRE_HOURS=24   # окно досылки просроченного при рестарте; старше — молча закрываются
REMINDER_RETENTION_DAYS=7   # срок хранения завершённых/отменённых; чистка при старте

# ─── Пинг-лист ─────────────────────────────────────────────
PING_DB_PATH=data/ping.db
PING_COOLDOWN_SECONDS=300   # кулдаун на @all, на беседу

# ─── Списки / очереди ──────────────────────────────────────
NOTES_DB_PATH=data/notes.db
NOTES_RETENTION_DAYS=30     # через сколько дней список удаляется при старте

# ─── Приветствие новых участников беседы ───────────────────
WELCOME_ENABLED=true
# Гифка (mp4 без звука или .gif). Нет файла — уйдёт только текст.
WELCOME_GIF_FILE=data/welcome.mp4

# ─── Промпты LLM ───────────────────────────────────────────
# Используйте кавычки и экранированные \n при необходимости.
PROMPT_TEMPLATE_CHAT=
PROMPT_TEMPLATE_BIRTHDAY_ACTIVE=
PROMPT_TEMPLATE_BIRTHDAY_FORMER=

# ─── Прочее ────────────────────────────────────────────────
TIMEZONE=Europe/Moscow
ENV=dev                   # dev | prod
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
